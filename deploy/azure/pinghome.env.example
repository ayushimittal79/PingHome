# Copy to deploy/azure/pinghome.env (gitignored) and fill in from provision.sh's output.
# setup-vm.sh installs this as /etc/pinghome/pinghome.env (mode 600) on the VM, where systemd
# loads it as the backend's environment.

# Public hostname printed by provision.sh - Caddy gets its HTTPS certificate for this name.
PINGHOME_DOMAIN=<label>.<region>.cloudapp.azure.com

SPRING_PROFILES_ACTIVE=cloud
PORT=8080

# Azure Database for MySQL enforces TLS - keep sslMode=REQUIRED.
DB_URL=jdbc:mysql://<mysql-host>.mysql.database.azure.com:3306/pinghome?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=pinghome
DB_PASSWORD=<the PINGHOME_MYSQL_PASSWORD you exported before provision.sh>

# openssl rand -base64 48   (the cloud profile refuses to start with the development default)
PINGHOME_JWT_SECRET=

# Firebase service-account JSON: setup-vm.sh/deploy.sh upload backend/firebase-service-account.json here.
PINGHOME_FIREBASE_CREDENTIALS_PATH=/etc/pinghome/firebase.json

# From provision.sh output. Read by the Application Insights Java agent.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Demo timers (shorter nudge/escalation windows for a live demonstration). Leave unset for real timings.
# DEMO_MODE=true
# PINGHOME_SCHEDULER_INTERVAL_MS=5000
# PINGHOME_NUDGE_TIMEOUT_MINUTES=1

# Optional Twilio SMS fallback - off unless you deliberately enable it.
PINGHOME_SMS_ENABLED=false
