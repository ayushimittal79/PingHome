<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Caller name">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/callerNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Ring after (seconds)"
        android:textColor="?attr/colorOnBackground" />

    <TextView
        android:id="@+id/delayValueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnBackground"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/delaySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="55"
        android:min="0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Save" />

    <!-- Shown only on Android 14+ while the app lacks the full-screen notification permission -->
    <TextView
        android:id="@+id/fullScreenHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="To make the simulated call take over a locked screen like a real call, allow full-screen notifications for PingHome."
        android:textAppearance="@style/TextAppearance.PingHome.BodyMuted"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fullScreenPermissionButton"
        style="@style/Widget.PingHome.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Allow full-screen notifications"
        android:visibility="gone" />

</LinearLayout>
