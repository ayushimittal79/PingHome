<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PingHome" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_muted</item>
        <item name="colorPrimaryDark">@color/navy_900</item>
        <item name="colorOnPrimary">@color/off_white</item>
        <item name="colorSecondary">@color/navy_800</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:colorBackground">@color/off_white</item>
        <item name="colorOnBackground">@color/text_primary_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorError">@color/sos_red</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PingHome.FakeCall" parent="Theme.PingHome">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="colorSurface">@color/navy_900</item>
        <item name="android:colorBackground">@color/navy_900</item>
        <item name="colorOnSurface">@color/off_white</item>
        <item name="colorOnBackground">@color/off_white</item>
    </style>
</resources>
