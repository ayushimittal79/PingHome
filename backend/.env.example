# Copy to .env for local use with a tool like `dotenv` or export these into your shell / IDE run
# configuration before `./mvnw spring-boot:run`. None of these have real values checked in -
# see ../docs/cloud-services.md and ../docs/setup.md for how to obtain each one.

# --- Database (local MySQL by default; Cloud SQL connection details in cloud deployment) ---
DB_URL=jdbc:mysql://localhost:3306/pinghome?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=pinghome
DB_PASSWORD=pinghome

# --- Auth ---
# Generate with: openssl rand -base64 48
PINGHOME_JWT_SECRET=replace-with-a-long-random-secret

# --- Demo mode ---
DEMO_MODE=false
SPRING_PROFILES_ACTIVE=

# --- Firebase Cloud Messaging (primary push channel) ---
# Paste the full service-account JSON contents as one line, OR point to a mounted file path.
PINGHOME_FIREBASE_CREDENTIALS_JSON=
PINGHOME_FIREBASE_CREDENTIALS_PATH=

# --- Twilio SMS (optional critical fallback - leave disabled unless you intend to use it) ---
PINGHOME_SMS_ENABLED=false
PINGHOME_TWILIO_ACCOUNT_SID=
PINGHOME_TWILIO_AUTH_TOKEN=
PINGHOME_TWILIO_FROM_NUMBER=
